{
   "background": {
      "service_worker": "lib/service_worker.js"
   },
   "action": {
      "default_icon": {
         "16": "data/icons/16.png",
         "32": "data/icons/32.png",
         "48": "data/icons/48.png",
         "64": "data/icons/64.png"
      },
      "default_title": "Dark Mode Plus"
   },
   "content_scripts": [ {
      "all_frames": true,
      "css": [ "data/content_script/inject.css" ],
      "exclude_globs": [ "*/chrome/newtab*" ],
      "js": [ "data/rules/rules.js", "data/content_script/inject.js", "data/content_script/resources/native.js" ],
      "match_about_blank": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "description": "A global dark theme for the web (Plus edition)",
   "developer": {
      "name": "Fabio Lucci"
   },
   "homepage_url": "https://github.com/bigbear2/Dark-Mode-Plus",
   "icons": {
      "128": "data/icons/128.png",
      "16": "data/icons/16.png",
      "32": "data/icons/32.png",
      "48": "data/icons/48.png",
      "64": "data/icons/64.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Dark Mode Plus",
   "offline_enabled": true,
   "options_ui": {
      "open_in_tab": true,
      "page": "data/options/options.html"
   },
   "permissions": [ "storage", "contextMenus" ],
   "host_permissions": [ "<all_urls>" ],
   "short_name": "dark-mode-plus",
   "version": "0.4.2",
   "web_accessible_resources": [{
      "resources": [ "data/content_script/custom/*", "data/content_script/general/*" ],
      "matches": [ "<all_urls>" ]
   }]
}
